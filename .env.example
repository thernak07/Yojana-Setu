# ─────────────────────────────────────────────────────────────
# Frontend Environment Configuration
# Copy to .env.local and adjust values
# ─────────────────────────────────────────────────────────────

# Backend API base URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App metadata
NEXT_PUBLIC_APP_NAME="SC/ST Credit Sahayak"
NEXT_PUBLIC_APP_DESC="AI-powered concessional credit discovery for SC beneficiaries"

# Default locale: en | hi
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Feature flags
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_MAPS=true
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Map tile provider (Leaflet)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
